<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: shop data stays on the device. Cloud backup is off; a direct phone-to-phone
     transfer started by the user is still allowed so owners can move to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
